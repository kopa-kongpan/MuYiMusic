APP_ENV=local
POSTGRES_USER=muyimusic
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_DB=muyimusic
DOCKER_POSTGRES_PORT=15432
DOCKER_REDIS_PORT=16379
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:10086,http://127.0.0.1:10086
JWT_SECRET=replace-with-a-random-secret
JWT_ACCESS_TOKEN_MINUTES=480
USER_ACCESS_TOKEN_MINUTES=10080
BOOKING_CUTOFF_MINUTES=120
CANCELLATION_CUTOFF_MINUTES=120
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=replace-with-at-least-12-characters
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TEMPLATE_TEACHER_NEW_APPOINTMENT=
WECHAT_TEMPLATE_TEACHER_APPOINTMENT_CANCELLED=
WECHAT_TEMPLATE_STUDENT_APPOINTMENT_CANCELLED=
WECHAT_TEMPLATE_APPOINTMENT_NEXT_DAY_REMINDER=
# JSON：按模板键配置微信字段，例如 {"appointment_next_day_reminder":{"course_name":"thing1","starts_at":"time2"}}
WECHAT_TEMPLATE_FIELD_MAP_JSON={}
DOUYIN_APP_ID=
DOUYIN_APP_SECRET=
SENTRY_DSN=

# 对象存储直传。provider 当前使用兼容 S3 API 的 COS、OSS 或 TOS Endpoint。
OBJECT_STORAGE_PROVIDER=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_SESSION_TOKEN=
OBJECT_STORAGE_PUBLIC_BASE_URL=
OBJECT_STORAGE_PATH_PREFIX=muyimusic
OBJECT_STORAGE_ADDRESSING_STYLE=virtual
OBJECT_STORAGE_UPLOAD_EXPIRES_SECONDS=900
OBJECT_STORAGE_DOWNLOAD_EXPIRES_SECONDS=3600
OBJECT_STORAGE_MAX_IMAGE_BYTES=10485760
OBJECT_STORAGE_MAX_VIDEO_BYTES=209715200

# ---------------------------------------------------------------------------
# 以下仅生产环境需要（deploy/compose.prod.yaml）。本地开发可全部留空。
# ---------------------------------------------------------------------------
# Caddy 托管的域名。三者需提前解析到服务器公网 IP，否则证书申请失败。
API_DOMAIN=
ADMIN_DOMAIN=
# H5 站点可选，不需要时留空。
H5_DOMAIN=
# Let's Encrypt 证书到期通知邮箱。
ACME_EMAIL=
# Redis 生产强制密码。生成：openssl rand -base64 24
REDIS_PASSWORD=
# uvicorn 进程数，建议等于 CPU 核数。
API_WORKERS=2
# 需 >= API_WORKERS × (pool_size + max_overflow) + worker 与运维连接。
POSTGRES_MAX_CONNECTIONS=100
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
# 备份脚本参数，见 deploy/scripts/backup-postgres.sh。
BACKUP_DIR=/var/backups/muyimusic
BACKUP_RETENTION_DAYS=30
BACKUP_COS_PATH=
